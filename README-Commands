# 1. Install Qt5 (one-time)
brew install qt@5

# 2. Initialize submodules (one-time)
cd ~/repos/writing-env/cool-retro-term
git submodule update --init --recursive

# 3. Generate Makefiles with qmake
/opt/homebrew/opt/qt@5/bin/qmake

# 4. Build
make -j$(sysctl -n hw.ncpu)

# 5. Rewrite the app bundle to use its bundled Qt frameworks and plugins
/opt/homebrew/opt/qt@5/bin/macdeployqt cool-retro-term.app

# 6. Copy to Applications (as test app) and re-sign it
rsync -a --delete cool-retro-term.app/ "/Applications/Retro Terminal TEST.app/" && codesign --force --deep --sign - "/Applications/Retro Terminal TEST.app"

Steps 3-6 are what you repeat after making changes. The built app is at cool-retro-term/cool-retro-term.app.
# A build script has been made for running Steps 3-6 in sequence. Type ./build-term in the terminal to run the script
